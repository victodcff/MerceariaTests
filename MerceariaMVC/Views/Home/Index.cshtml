@{
    ViewData["Title"] = "Painel Inicial";
}

<div class="p-4 p-md-5 mb-4 rounded-4 text-white bg-success shadow-sm">
    <div class="col-md-8 px-0">
        <h1 class="display-5 fw-bold">Bem-vindo à MerceariaMVC!</h1>
        <p class="lead my-3">Gerencie seus clientes, produtos e vendas em um só lugar de forma simples, rápida e intuitiva.</p>
    </div>
</div>

<div class="row g-4 text-center">
    <!-- Card Clientes -->
    <div class="col-md-6 col-lg-4">
        <div class="card h-100 border-0 shadow-sm rounded-4 p-3 hover-card">
            <div class="card-body d-flex flex-column align-items-center justify-content-center">
                <div class="icon-shape bg-success bg-opacity-10 text-success rounded-circle mb-3 p-3">
                    <i class="bi bi-people-fill fs-1"></i>
                </div>
                <h5 class="card-title fw-bold">Clientes</h5>
                <p class="card-text text-muted small">Cadastre novos clientes, consulte dados e histórico de compras.</p>
                <a asp-controller="Cliente" asp-action="Index" class="btn btn-outline-success rounded-pill px-4 mt-2">Gerenciar Clientes</a>
            </div>
        </div>
    </div>

    <!-- Card Produtos -->
    <div class="col-md-6 col-lg-4">
        <div class="card h-100 border-0 shadow-sm rounded-4 p-3 hover-card">
            <div class="card-body d-flex flex-column align-items-center justify-content-center">
                <div class="icon-shape bg-warning bg-opacity-10 text-warning rounded-circle mb-3 p-3">
                    <i class="bi bi-box-seam-fill fs-1"></i>
                </div>
                <h5 class="card-title fw-bold">Produtos</h5>
                <p class="card-text text-muted small">Controle seu estoque, atualize preços e organize por categorias.</p>
                <a asp-controller="Produto" asp-action="Index" class="btn btn-outline-warning text-dark rounded-pill px-4 mt-2">Gerenciar Produtos</a>
            </div>
        </div>
    </div>

    <!-- Card Vendas / Caixa -->
    <div class="col-md-12 col-lg-4">
        <div class="card h-100 border-0 shadow-sm rounded-4 p-3 hover-card">
            <div class="card-body d-flex flex-column align-items-center justify-content-center">
                <div class="icon-shape bg-primary bg-opacity-10 text-primary rounded-circle mb-3 p-3">
                    <i class="bi bi-cart-check-fill fs-1"></i>
                </div>
                <h5 class="card-title fw-bold">Novo Pedido</h5>
                <p class="card-text text-muted small">Inicie uma nova venda rápida registrando os produtos selecionados.</p>
                <button class="btn btn-primary rounded-pill px-4 mt-2" disabled>Em Breve</button>
            </div>
        </div>
    </div>
</div>