@model IEnumerable<MerceariaMVC.Models.Produto>

@{
    ViewData["Title"] = "Produtos";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0 text-dark"><i class="bi bi-box-seam text-warning me-2"></i>Gestão de Produtos</h2>
        <p class="text-muted small mb-0">Consulte, adicione e gerencie o estoque da mercearia.</p>
    </div>
    <a asp-action="Create" class="btn btn-warning rounded-pill px-4 shadow-sm fw-bold">
        <i class="bi bi-plus-lg me-1"></i> Novo Produto
    </a>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light border-bottom">
                    <tr>
                        <th class="ps-4">@Html.DisplayNameFor(model => model.Nome)</th>
                        <th>@Html.DisplayNameFor(model => model.Preco)</th>
                        <th>@Html.DisplayNameFor(model => model.Estoque)</th>
                        <th class="text-end pe-4">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-semibold text-dark">
                                @Html.DisplayFor(modelItem => item.Nome)
                            </td>
                            <td class="text-success fw-bold">
                                @item.Preco.ToString("C")
                            </td>
                            <td>
                                @if (item.Estoque > 10)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3">@item.Estoque un</span>
                                }
                                else if (item.Estoque > 0)
                                {
                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-3">@item.Estoque un (Baixo)</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3">Esgotado</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <div class="btn-group" role="group">
                                    <a asp-action="Edit" asp-route-id="@item.IdProduto" class="btn btn-sm btn-outline-primary" title="Editar">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="Details" asp-route-id="@item.IdProduto" class="btn btn-sm btn-outline-info" title="Detalhes">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.IdProduto" class="btn btn-sm btn-outline-danger" title="Excluir">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>