@model MerceariaMVC.Models.Produto

@{
    ViewData["Title"] = "Detalhes do Produto";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card border-0 shadow-sm rounded-4 p-4">
            <h4 class="fw-bold text-dark mb-3"><i class="bi bi-info-circle text-info me-2"></i>Detalhes do Produto</h4>
            <hr />
            <dl class="row mb-4">
                <dt class="col-sm-4 text-muted fw-normal">@Html.DisplayNameFor(model => model.Nome)</dt>
                <dd class="col-sm-8 fw-bold fs-5 text-dark">@Html.DisplayFor(model => model.Nome)</dd>

                <dt class="col-sm-4 text-muted fw-normal">@Html.DisplayNameFor(model => model.Preco)</dt>
                <dd class="col-sm-8 text-success fw-bold fs-5">@Model.Preco.ToString("C")</dd>

                <dt class="col-sm-4 text-muted fw-normal">@Html.DisplayNameFor(model => model.Estoque)</dt>
                <dd class="col-sm-8 fw-semibold">@Model.Estoque unidades</dd>
            </dl>
            <div class="d-flex gap-2">
                <a asp-action="Edit" asp-route-id="@Model?.IdProduto" class="btn btn-primary rounded-pill flex-grow-1">Editar</a>
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill">Voltar</a>
            </div>
        </div>
    </div>
</div>