@model MerceariaMVC.Models.Cliente

@{
    ViewData["Title"] = "Detalhes do Cliente";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card border-0 shadow-sm rounded-4 p-4">
            <h4 class="fw-bold text-dark mb-3"><i class="bi bi-info-circle text-info me-2"></i>Detalhes do Cliente</h4>
            <hr />
            <dl class="row mb-4">
                <dt class="col-sm-4 text-muted fw-normal">@Html.DisplayNameFor(model => model.Nome)</dt>
                <dd class="col-sm-8 fw-bold fs-5 text-dark">@Html.DisplayFor(model => model.Nome)</dd>

                <dt class="col-sm-4 text-muted fw-normal">@Html.DisplayNameFor(model => model.Email)</dt>
                <dd class="col-sm-8 text-muted">@Html.DisplayFor(model => model.Email)</dd>

                <dt class="col-sm-4 text-muted fw-normal">@Html.DisplayNameFor(model => model.Idade)</dt>
                <dd class="col-sm-8 text-muted">@Html.DisplayFor(model => model.Idade) anos</dd>

                <dt class="col-sm-4 text-muted fw-normal">@Html.DisplayNameFor(model => model.Ativo)</dt>
                <dd class="col-sm-8">
                    @if (Model.Ativo)
                    {
                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3">Ativo</span>
                    }
                    else
                    {
                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3">Inativo</span>
                    }
                </dd>
            </dl>
            <div class="d-flex gap-2">
                <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary rounded-pill flex-grow-1">Editar</a>
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill">Voltar</a>
            </div>
        </div>
    </div>
</div>